{
  "name": "@alisaitteke/photoshop-mcp",
  "version": "1.7.5",
  "description": "MCP server for Adobe Photoshop — 118 tools (generative AI + recipes). Control Photoshop from Cursor, Claude, or natural language.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "photoshop-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "uxp-plugin",
    "examples",
    "README.md",
    "LICENSE",
    "llms.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "verify:photoshop-prompts": "tsx scripts/verify-photoshop-prompt-coverage.ts",
    "test:mcp-local": "tsx scripts/test-mcp-local.ts",
    "test:mcp-all": "tsx scripts/test-all-mcp-tools.ts",
    "test:intent-expansion": "tsx scripts/test-intent-expansion-local.ts",
    "prepare": "npm run build",
    "sync:server-version": "tsx scripts/sync-server-version.ts",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "prepublishOnly": "npm run build && npm run sync:server-version",
    "test:unit": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "photoshop",
    "adobe",
    "automation",
    "ai",
    "ai-agents",
    "cursor",
    "claude",
    "image-editing",
    "typescript",
    "extendscript",
    "developer-tools"
  ],
  "author": "Ali Sait Teke (https://alisait.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisaitteke/photoshop-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alisaitteke/photoshop-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.4.3"
  },
  "mcpName": "io.github.alisaitteke/photoshop-mcp",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
